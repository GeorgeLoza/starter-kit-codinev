@'
# Dependencias
node_modules/
vendor/

# Entorno
.env
.env.local
.env.*.local

# Builds
dist/
build/
.expo/
web-build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# Laravel
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*
'@ | Set-Content -Path .gitignore